# --- Base de datos (PostgreSQL) ---
DATABASE_URL="postgresql://archeo:archeo@localhost:5432/archeoarchive?schema=public"

# --- Sesión ---
# Mínimo 32 caracteres aleatorios. Generar con:  openssl rand -base64 48
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-o-mas-caracteres"

# --- Administrador inicial (lo crea `npm run db:seed`) ---
ADMIN_NOMBRE="Administrador"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="cambia-esta-contrasena-12+"

# --- Almacenamiento de archivos ---
# Directorio PERSISTENTE (volumen montado en producción). No usar /tmp.
STORAGE_DIR="./storage"
MAX_IMAGE_MB="8"
MAX_MODEL_MB="50"
